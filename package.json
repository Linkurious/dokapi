{
  "name": "dokapi",
  "description": "A Markdown-based Website generator with advanced features",
  "keywords": [
    "documentation",
    "generator",
    "markdown",
    "html",
    "pdf",
    "api",
    "doc",
    "template",
    "mustache",
    "variable",
    "code",
    "okapi"
  ],
  "engines": {
    "node": ">=24.21"
  },
  "version": "2.0.10",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkurious/dokapi.git"
  },
  "author": {
    "name": "David Rapin",
    "url": "https://github.com/davidrapin"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/Linkurious/dokapi/issues"
  },
  "license": "MIT",
  "files": [
    "src"
  ],
  "main": "src/dokapi.js",
  "bin": {
    "dokapi": "src/dokapi.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "//": "invoked using >npm run [script-name]",
    "lint:ci": "eslint ./src",
    "lint": "eslint --fix ./src",
    "build": "npm run lint:ci",
    "test": "node --test 'test/**/*.spec.js'",
    "test:unit": "node --test 'test/**/*.spec.js'",
    "bump:patch": "bump2version patch && npm version --no-git-tag-version patch",
    "bump:minor": "bump2version minor && npm version --no-git-tag-version minor",
    "bump:major": "bump2version major && npm version --no-git-tag-version major"
  },
  "dependencies": {
    "commander": "2.20.3",
    "fs-extra": "11.4.1",
    "highlight.js": "11.12.0",
    "highlightjs-cypher": "1.2.0",
    "lodash.defaults": "4.2.0",
    "lodash.difference": "4.5.0",
    "marked": "3.0.8",
    "valcheck": "1.2.6",
    "watch": "1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0"
  }
}
